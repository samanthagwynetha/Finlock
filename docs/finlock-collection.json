{
  "info": {
    "name": "FinLock API",
    "description": "Distributed Wallet System API — complete collection for testing all endpoints.\n\n**Quick Start:**\n1. Import this collection and the FinLock Environment\n2. Select 'FinLock Environment' from the environment dropdown\n3. Run 'Register' to create a user\n4. Run 'Login' — the JWT token is automatically saved\n5. All other requests use the token automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Juan dela Cruz\",\n  \"email\": \"juan@finlock.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.environment.set('token', json.data.token);",
                  "    console.log('Token saved automatically');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@finlock.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"PHP\",\n  \"initialBalance\": 1000.00\n}"
            },
            "url": "{{base_url}}/api/wallets"
          }
        },
        {
          "name": "Get My Wallets",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/wallets/me"
          }
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"PHP\",\n  \"amount\": 500.00\n}"
            },
            "url": "{{base_url}}/api/wallets/deposit"
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"PHP\",\n  \"amount\": 200.00\n}"
            },
            "url": "{{base_url}}/api/wallets/withdraw"
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer Funds",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Idempotency-Key", "value": "{{$guid}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"maria@finlock.com\",\n  \"currency\": \"PHP\",\n  \"amount\": 100.00\n}"
            },
            "url": "{{base_url}}/api/transfers"
          }
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/transfers"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ]
}
